{
  "$schema": "../node_modules/@dashou/cli/schema/plugin-1.json",
  "schemaVersion": 1,
  "id": "com.dashou.markcard",
  "name": "MarkCard Studio",
  "version": "1.0.0",
  "description": "Markdown 图文卡片工作台：实时排版、18 款主题、多平台画幅，导出 PNG / JPG / PDF / 长图。",
  "author": { "name": "xiaobin" },
  "homepage": "https://github.com/pangxiaobin/MarkCardStudio",
  "license": "GPL-3.0-only",
  "icon": "assets/icon.png",
  "core": "core.mjs",
  "activation": "onCommand",
  "resident": false,
  "csp": "img-src 'self' plugin: data: blob: https: http:; font-src 'self' plugin: data: blob: https: http:; media-src 'self' plugin: data: blob: https: http:; worker-src 'self' plugin: blob:",
  "windows": [
    {
      "label": "main",
      "title": "MarkCard Studio",
      "url": "ui/index.html",
      "width": 1440,
      "height": 900,
      "minWidth": 1024,
      "minHeight": 680,
      "center": true,
      "resizable": true,
      "backgroundColor": "#f4f6fb"
    }
  ],
  "commands": [
    {
      "id": "open",
      "title": "MarkCard Studio",
      "description": "把 Markdown 排版成小红书 / 抖音 / 微博图文卡片",
      "keywords": [
        "markcard",
        "markcard studio",
        "卡片",
        "图文卡片",
        "markdown卡片",
        "小红书卡片",
        "抖音卡片",
        "长图卡片",
        "排版卡片"
      ],
      "mode": "window",
      "window": "main"
    },
    {
      "id": "open-files",
      "title": "用 MarkCard Studio 打开这些 Markdown",
      "description": "把选中的 Markdown 稿件交给 MarkCard Studio 排版成卡片",
      "match": {
        "type": "files",
        "fileType": "file",
        "extensions": ["md", "markdown", "mdown", "mkd"]
      },
      "mode": "window",
      "window": "main"
    }
  ],
  "capabilities": [
    {
      "identifier": "main-ui",
      "targets": ["main"],
      "permissions": [
        "core:event:allow-listen",
        "core:window:allow-close",
        "dialog:allow-open",
        "dialog:allow-save",
        "opener:allow-open-url"
      ]
    },
    {
      "identifier": "core-base",
      "targets": ["core"],
      "permissions": [
        "core:event:allow-emit",
        "log:allow-log"
      ]
    }
  ],
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5177",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "dist"
  }
}
